# Configuration template for Transformer Interpretability Project
# Copy this file to .env for local customization.

APP_NAME=Transformer Interpretability Dashboard
MODEL_PATH=models/final_model.pth
TOKENIZER_NAME=google-bert/bert-base-uncased
DATASET_NAME=stanfordnlp/imdb

MAX_LEN=128
D_MODEL=128
NUM_HEADS=4
NUM_LAYERS=2
D_FF=256
DROPOUT=0.1
NUM_CLASSES=2

TRAIN_BATCH_SIZE=32
EVAL_BATCH_SIZE=32
EPOCHS=3
LEARNING_RATE=0.0005
WARMUP_STEPS=500
MAX_GRAD_NORM=1.0
SEED=42
DEVICE=auto
PYTHONPATH=.
